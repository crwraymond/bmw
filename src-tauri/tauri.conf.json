{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toko Offline",
  "version": "0.2.0",
  "identifier": "local.tokooffline.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toko Offline",
        "theme": "Dark",
        "fullscreen": true,
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https://pldeedsmovompchrmtsu.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzRjI4OEQ1RjkzRTUyMTcKUldRWFVqNzUxWWp5cy90MERjdEM1Qm9aNnJTUU9xWTBuZXFUa0lPZGJRcUgxS2lkQTlOLzBOVHoK",
      "endpoints": [
        "https://github.com/crwraymond/bmw/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
