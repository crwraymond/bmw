{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:window:allow-close",
    "dialog:allow-open",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install"
  ]
}
